# Copy this file to .env and fill in your values (.env is git-ignored).
# Supabase dashboard -> Project Settings -> API
#
# Use the public "anon" / "publishable" key ONLY. Never put the service_role / secret key here.
# On Netlify add the same two names under Site settings -> Environment variables.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
